{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/objects/projects/project-task.schema.json",
  "title": "ABCS Project Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["number", "project", "name", "status"],
  "properties": {
    "number": {"type": "string", "minLength": 1},
    "project": {"$ref": "../../common/business-object-reference.schema.json"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "assignedTo": {"$ref": "../../common/business-object-reference.schema.json"},
    "plannedStartDate": {"type": "string", "format": "date"},
    "plannedEndDate": {"type": "string", "format": "date"},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle"],
      "properties": {"lifecycle": {"type": "string", "enum": ["planned", "ready", "in-progress", "completed", "cancelled"]}}
    }
  }
}
