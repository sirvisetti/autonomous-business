{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/objects/manufacturing/material-issue.schema.json",
  "title": "ABCS Material Issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["number", "manufacturer", "issueDate", "lines", "status"],
  "properties": {
    "number": {"type": "string", "minLength": 1},
    "manufacturer": {"$ref": "../../common/party-reference.schema.json"},
    "workOrder": {"$ref": "../../common/business-object-reference.schema.json"},
    "productionOrder": {"$ref": "../../common/business-object-reference.schema.json"},
    "issueDate": {"type": "string", "format": "date"},
    "sourceLocation": {"type": "string"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineNumber", "material", "quantity"],
        "properties": {
          "lineNumber": {"type": "integer", "minimum": 1},
          "material": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "quantity": {"$ref": "../../common/quantity.schema.json"}
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle"],
      "properties": {"lifecycle": {"type": "string", "enum": ["recorded", "reversed"]}}
    }
  }
}
