{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/objects/logistics/inventory-transfer.schema.json",
  "title": "ABCS Inventory Transfer",
  "type": "object",
  "additionalProperties": false,
  "required": ["number", "organization", "fromLocation", "toLocation", "lines", "status"],
  "properties": {
    "number": {"type": "string", "minLength": 1},
    "organization": {"$ref": "../../common/party-reference.schema.json"},
    "fromLocation": {"type": "string", "minLength": 1},
    "toLocation": {"type": "string", "minLength": 1},
    "transferDate": {"type": "string", "format": "date"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineNumber", "item", "quantity"],
        "properties": {
          "lineNumber": {"type": "integer", "minimum": 1},
          "item": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "quantity": {"$ref": "../../common/quantity.schema.json"}
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle"],
      "properties": {
        "lifecycle": {"type": "string", "enum": ["draft", "released", "in-transit", "received", "cancelled"]}
      }
    }
  }
}
