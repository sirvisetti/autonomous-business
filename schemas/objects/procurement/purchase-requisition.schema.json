{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/objects/procurement/purchase-requisition.schema.json",
  "title": "ABCS Procurement Purchase Requisition",
  "type": "object",
  "additionalProperties": false,
  "required": ["number", "requester", "requestDate", "lines", "status"],
  "properties": {
    "number": {"type": "string", "minLength": 1},
    "requester": {"$ref": "https://abcs.sirvisetti.com/schemas/common/party-reference.schema.json"},
    "requestDate": {"type": "string", "format": "date"},
    "needByDate": {"type": "string", "format": "date"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineNumber", "description", "quantity"],
        "properties": {
          "lineNumber": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "quantity": {"$ref": "https://abcs.sirvisetti.com/schemas/common/quantity.schema.json"},
          "estimatedUnitPrice": {"$ref": "https://abcs.sirvisetti.com/schemas/common/monetary-amount.schema.json"}
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "approval"],
      "properties": {
        "lifecycle": {"type": "string", "enum": ["draft", "open", "fulfilled", "cancelled"]},
        "approval": {"type": "string", "enum": ["not-submitted", "pending", "approved", "rejected"]}
      }
    }
  }
}
