{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/objects/sales/return.schema.json",
  "title": "ABCS Sales Return",
  "type": "object",
  "additionalProperties": false,
  "required": ["number", "customer", "salesOrder", "requestDate", "lines", "status"],
  "properties": {
    "number": {"type": "string", "minLength": 1},
    "customer": {"$ref": "https://abcs.sirvisetti.com/schemas/common/business-object-reference.schema.json"},
    "salesOrder": {"$ref": "https://abcs.sirvisetti.com/schemas/common/business-object-reference.schema.json"},
    "requestDate": {"type": "string", "format": "date"},
    "reason": {"type": "string"},
    "lines": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["lineNumber", "quantity"], "properties": {"lineNumber": {"type": "integer", "minimum": 1}, "salesOrderLineNumber": {"type": "integer", "minimum": 1}, "quantity": {"$ref": "https://abcs.sirvisetti.com/schemas/common/quantity.schema.json"}, "reason": {"type": "string"}}}},
    "status": {"type": "object", "additionalProperties": false, "required": ["lifecycle", "refund"], "properties": {"lifecycle": {"type": "string", "enum": ["draft", "requested", "authorized", "received", "completed", "rejected", "cancelled"]}, "refund": {"type": "string", "enum": ["not-required", "pending", "partially-refunded", "refunded"]}}}
  }
}
