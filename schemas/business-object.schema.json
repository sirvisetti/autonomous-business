{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/business-object.schema.json",
  "title": "ABCS Business Object Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["abcs", "id", "title", "domain", "summary", "schema"],
  "properties": {
    "abcs": {"type": "string", "const": "0.2"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "summary": {"type": "string", "minLength": 1},
    "schema": {"type": "string", "minLength": 1},
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fields"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "primary": {"type": "boolean", "default": false},
          "fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "cardinality"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "cardinality": {"type": "string", "enum": ["one", "many"]},
          "required": {"type": "boolean"},
          "inverse": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "stateDimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {"type": "string", "const": "GREEN"},
        "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
