{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/capabilities/procurement/purchase-order-search-input.schema.json",
  "title": "Search Purchase Orders Input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "number": {"type": "string"},
    "buyer": {"$ref": "https://abcs.sirvisetti.com/schemas/common/party-reference.schema.json"},
    "supplier": {"$ref": "https://abcs.sirvisetti.com/schemas/common/party-reference.schema.json"},
    "orderDateFrom": {"type": "string", "format": "date"},
    "orderDateTo": {"type": "string", "format": "date"},
    "approvalState": {"type": "string", "enum": ["not-required", "not-submitted", "pending", "approved", "rejected"]},
    "lifecycleState": {"type": "string", "enum": ["draft", "open", "closed", "cancelled"]}
  }
}
