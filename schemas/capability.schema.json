{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/capability.schema.json",
  "title": "ABCS Capability Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["abcs", "id", "title", "domain", "kind", "summary"],
  "properties": {
    "abcs": {"type": "string", "const": "0.2"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"type": "string", "enum": ["query", "command"]},
    "summary": {"type": "string", "minLength": 1},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "role"],
        "properties": {
          "object": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "role": {"type": "string", "enum": ["primary", "input", "output", "reference"]}
        }
      }
    },
    "input": {"$ref": "#/$defs/contract"},
    "output": {"$ref": "#/$defs/contract"},
    "preconditions": {"type": "object"},
    "effects": {"type": "object"},
    "relationships": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"},
        "uniqueItems": true
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {"schema": {"type": "string", "minLength": 1}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {"type": "string", "const": "GREEN"},
        "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
