{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abcs.sirvisetti.com/schemas/common/business-object-reference.schema.json",
  "title": "ABCS Business Object Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["object", "key"],
  "properties": {
    "object": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "key": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}}
  }
}
